{
  "_about": "Naming parity: the engine (omnibus-engine/src/naming.rs) and Node (src/lib/utils/naming.ts) must turn the same inputs into byte-identical names. Both test suites read this file. patternChoice: which template one issue gets (renamer.rs file_pattern_for_issue / file-pattern.ts filePatternForIssue). Padding: \"none\", \"2\", \"3\"; anything else (\"\", unknown) means the default, 3.",
  "padIssue": [
    ["1", "3", "001"], ["1", "2", "01"], ["1", "none", "1"], ["1", "", "001"], ["1", "bogus", "001"],
    ["38", "3", "038"], ["38", "2", "38"], ["38", "none", "38"],
    ["100", "3", "100"], ["100", "2", "100"], ["100", "none", "100"],
    ["1000", "3", "1000"], ["1000", "none", "1000"],
    ["0", "3", "000"], ["0", "2", "00"], ["0", "none", "0"],
    ["", "3", "000"], ["", "2", "00"], ["", "none", "0"],
    ["001", "3", "001"], ["001", "2", "01"], ["001", "none", "1"],
    ["0001", "3", "001"], ["0001", "none", "1"],
    [" 7 ", "3", "007"],
    ["1.5", "3", "001.5"], ["1.5", "2", "01.5"], ["1.5", "none", "1.5"],
    ["-1", "3", "-001"], ["-1", "2", "-01"], ["-1", "none", "-1"],
    ["-2.1", "3", "-002.1"],
    ["1A", "3", "001A"], ["1A", "2", "01A"], ["1A", "none", "1A"],
    ["12A", "3", "012A"], ["12A", "2", "12A"],
    ["½", "3", "000.5"], ["½", "2", "00.5"], ["½", "none", "0.5"],
    ["1½", "3", "001.5"],
    [".5", "3", "000.5"], [".5", "none", "0.5"],
    ["1.MU", "3", "001.MU"], ["1.MU", "none", "1.MU"],
    ["Annual 1", "3", "Annual 1"],
    ["TPB", "3", "TPB"]
  ],
  "issueYear": [
    { "releaseDate": "2026-01-14", "comicInfoYear": 2025, "seriesYear": 2024, "expected": "2026" },
    { "releaseDate": "2026-01-14T00:00:00.000Z", "comicInfoYear": null, "seriesYear": 2024, "expected": "2026" },
    { "releaseDate": null, "comicInfoYear": 2026, "seriesYear": 2024, "expected": "2026" },
    { "releaseDate": "", "comicInfoYear": 2026, "seriesYear": 2024, "expected": "2026" },
    { "releaseDate": null, "comicInfoYear": null, "seriesYear": 2024, "expected": "2024" },
    { "releaseDate": "TBA", "comicInfoYear": 106705, "seriesYear": 2024, "expected": "2024" },
    { "releaseDate": null, "comicInfoYear": 201234, "seriesYear": 2016, "expected": "2016" },
    { "releaseDate": "0000-00-00", "comicInfoYear": 0, "seriesYear": 0, "expected": "" },
    { "releaseDate": null, "comicInfoYear": null, "seriesYear": 1, "expected": "" }
  ],
  "files": [
    { "label": "the default pattern, default padding", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "3" }, "expected": "Batman #003" },
    { "label": "two-digit padding", "pattern": "{Series} #{Issue}", "padding": "2", "input": { "series": "Batman", "issueNumber": "3" }, "expected": "Batman #03" },
    { "label": "no padding strips stored zeros", "pattern": "{Series} #{Issue}", "padding": "none", "input": { "series": "Batman", "issueNumber": "003" }, "expected": "Batman #3" },
    { "label": "the issue's own year (#243)", "pattern": "{Series} #{Issue} ({IssueYear})", "padding": "3", "input": { "series": "X-Men", "seriesYear": 2024, "issueNumber": "38", "releaseDate": "2026-01-14" }, "expected": "X-Men #038 (2026)" },
    { "label": "unknown years leave no (0000) and no empty parens", "pattern": "{Series} ({Year}) #{Issue} ({IssueYear})", "padding": "3", "input": { "series": "Batman", "seriesYear": 0, "issueNumber": "1" }, "expected": "Batman #001" },
    { "label": "an implausible release date falls back to the series year", "pattern": "{Series} #{Issue} ({IssueYear})", "padding": "3", "input": { "series": "Batman", "seriesYear": 2016, "issueNumber": "1", "releaseDate": "TBA" }, "expected": "Batman #001 (2016)" },
    { "label": "the annual pattern", "pattern": "{Series} Annual #{Issue} ({IssueYear})", "padding": "3", "input": { "series": "Batman", "seriesYear": 2012, "issueNumber": "1" }, "expected": "Batman Annual #001 (2012)" },
    { "label": "the collected pattern with VolumeYear", "pattern": "{Series} Vol. {Issue} ({VolumeYear})", "padding": "3", "input": { "series": "Saga", "seriesYear": 2012, "issueNumber": "1" }, "expected": "Saga Vol. 001 (2012)" },
    { "label": "tokens are case-insensitive", "pattern": "{series} - {ISSUE}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Batman - 001" },
    { "label": "$& in metadata stays literal", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "Cash $& Carry", "issueNumber": "1" }, "expected": "Cash $& Carry #001" },
    { "label": "a value is never expanded again", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "{Issue}", "issueNumber": "1" }, "expected": "{Issue} #001" },
    { "label": "an unknown token stays as written", "pattern": "{Series} {Volume} #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Batman {Volume} #001" },
    { "label": "a blank imprint takes its separator with it", "pattern": "{Imprint} - {Series} #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Batman #001" },
    { "label": "an imprint", "pattern": "{Imprint} - {Series} #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1", "imprint": "Black Label" }, "expected": "Black Label - Batman #001" },
    { "label": "doubled hyphens collapse once", "pattern": "{Series} --- #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Batman - - #001" },
    { "label": "an issue title", "pattern": "{Series} #{Issue} - {IssueTitle}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1", "issueTitle": "The Court of Owls" }, "expected": "Batman #001 - The Court of Owls" },
    { "label": "no issue title", "pattern": "{Series} #{Issue} - {IssueTitle}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Batman #001" },
    { "label": "illegal characters are stripped", "pattern": "{Series} #{Issue} - {IssueTitle}", "padding": "3", "input": { "series": "Batman: Year One", "issueNumber": "1", "issueTitle": "Who? Me*" }, "expected": "Batman Year One #001 - Who Me" },
    { "label": "a series ending in a period keeps it inside the name", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "S.H.I.E.L.D.", "issueNumber": "1" }, "expected": "S.H.I.E.L.D. #001" },
    { "label": "leading dots never start a name", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "...And Justice", "issueNumber": "1" }, "expected": "And Justice #001" },
    { "label": "an unknown publisher in a file name", "pattern": "{Publisher} - {Series} #{Issue}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": "Unknown - Batman #001" },
    { "label": "a slash in the number never becomes a folder", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "Wizard", "issueNumber": "1/2" }, "expected": "Wizard #0012" },
    { "label": "a fraction is a decimal", "pattern": "{Series} #{Issue}", "padding": "3", "input": { "series": "X-Men", "issueNumber": "½" }, "expected": "X-Men #000.5" },
    { "label": "universe and series group", "pattern": "{UniverseName} {SeriesGroup} {Series} #{Issue}", "padding": "3", "input": { "series": "Amazing Spider-Man", "issueNumber": "1", "universe": "Earth-616", "seriesGroup": "Spider-Man" }, "expected": "Earth-616 Spider-Man Amazing Spider-Man #001" },
    { "label": "a pattern that leaves nothing", "pattern": "{Imprint}", "padding": "3", "input": { "series": "Batman", "issueNumber": "1" }, "expected": null }
  ],
  "folders": [
    { "label": "the default pattern", "pattern": "{Publisher}/{Series} ({Year})", "input": { "publisher": "DC Comics", "series": "Batman", "seriesYear": 2016 }, "expected": ["DC Comics", "Batman (2016)"] },
    { "label": "no publisher", "pattern": "{Publisher}/{Series} ({Year})", "input": { "series": "Batman", "seriesYear": 2016 }, "expected": ["Other", "Batman (2016)"] },
    { "label": "the Unknown publisher", "pattern": "{Publisher}/{Series} ({Year})", "input": { "publisher": "Unknown", "series": "Batman", "seriesYear": 2016 }, "expected": ["Other", "Batman (2016)"] },
    { "label": "no year", "pattern": "{Publisher}/{Series} ({Year})", "input": { "publisher": "DC Comics", "series": "Batman", "seriesYear": 0 }, "expected": ["DC Comics", "Batman"] },
    { "label": "an implausible year", "pattern": "{Publisher}/{Series} ({VolumeYear})", "input": { "publisher": "DC Comics", "series": "Batman", "seriesYear": 1 }, "expected": ["DC Comics", "Batman"] },
    { "label": "a blank imprint drops its tier", "pattern": "{Imprint}/{Publisher}/{Series} ({Year})", "input": { "publisher": "DC Comics", "series": "Batman", "seriesYear": 2016 }, "expected": ["DC Comics", "Batman (2016)"] },
    { "label": "an imprint tier", "pattern": "{Imprint}/{Publisher}/{Series} ({Year})", "input": { "publisher": "DC Comics", "series": "Batman", "seriesYear": 2016, "imprint": "Black Label" }, "expected": ["Black Label", "DC Comics", "Batman (2016)"] },
    { "label": "a series group tier", "pattern": "{SeriesGroup}/{Series} ({Year})", "input": { "series": "Amazing Spider-Man", "seriesYear": 2022, "seriesGroup": "Spider-Man" }, "expected": ["Spider-Man", "Amazing Spider-Man (2022)"] },
    { "label": "a universe tier", "pattern": "{UniverseName}/{Series}", "input": { "series": "Batman", "universe": "Earth-2" }, "expected": ["Earth-2", "Batman"] },
    { "label": "tokens are case-insensitive", "pattern": "{publisher}/{SERIES}", "input": { "publisher": "DC Comics", "series": "Batman" }, "expected": ["DC Comics", "Batman"] },
    { "label": "$& in metadata stays literal", "pattern": "{Publisher}/{Series} ({Year})", "input": { "publisher": "DC Comics", "series": "Cash $& Carry", "seriesYear": 2016 }, "expected": ["DC Comics", "Cash $& Carry (2016)"] },
    { "label": "a dots-only value becomes _", "pattern": "{Publisher}/{Series}", "input": { "publisher": "..", "series": ".." }, "expected": ["_", "_"] },
    { "label": "a slash in a value never adds a tier", "pattern": "{Publisher}/{Series}", "input": { "publisher": "DC Comics", "series": "AC/DC" }, "expected": ["DC Comics", "ACDC"] },
    { "label": "a pattern that climbs out", "pattern": "../{Series}", "input": { "series": "Batman" }, "expected": null },
    { "label": "a drive prefix", "pattern": "C:/{Series}", "input": { "series": "Batman" }, "expected": null },
    { "label": "a pattern that leaves no folder", "pattern": "{SeriesGroup}", "input": { "series": "Batman" }, "expected": null }
  ],
  "patternChoice": [
    {"label": "a plain issue takes the series pattern", "annual": false, "collected": false, "retainedCollected": false, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} #{Issue}"},
    {"label": "manga takes the manga pattern", "annual": false, "collected": false, "retainedCollected": false, "manga": true, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Vol. {Issue}"},
    {"label": "an annual takes the Mylar annual name", "annual": true, "collected": false, "retainedCollected": false, "manga": true, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Annual #{Issue} ({IssueYear})"},
    {"label": "a collected edition's book takes the collected default", "annual": false, "collected": true, "retainedCollected": false, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Vol. {Issue} ({IssueYear})"},
    {"label": "the collected pattern is configurable", "annual": false, "collected": true, "retainedCollected": false, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": "{Series} v{Issue}", "expected": "{Series} v{Issue}"},
    {"label": "a blank collected pattern falls back to the default", "annual": false, "collected": true, "retainedCollected": false, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": "   ", "expected": "{Series} Vol. {Issue} ({IssueYear})"},
    {"label": "collected outranks annual and manga", "annual": true, "collected": true, "retainedCollected": false, "manga": true, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Vol. {Issue} ({IssueYear})"},
    {"label": "#239: a series kept as its own by a COLLECTED attachment names its books as collected editions", "annual": false, "collected": false, "retainedCollected": true, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Vol. {Issue} ({IssueYear})"},
    {"label": "#239: a kept-as-its-own collected series uses the configured collected pattern", "annual": false, "collected": false, "retainedCollected": true, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": "{Series} v{Issue}", "expected": "{Series} v{Issue}"},
    {"label": "#239: a kept-as-its-own collected series outranks the manga pattern", "annual": false, "collected": false, "retainedCollected": true, "manga": true, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Vol. {Issue} ({IssueYear})"},
    {"label": "#239: an annual inside such a series keeps its annual name", "annual": true, "collected": false, "retainedCollected": true, "manga": false, "filePattern": "{Series} #{Issue}", "mangaFilePattern": "{Series} Vol. {Issue}", "collectedFilePattern": null, "expected": "{Series} Annual #{Issue} ({IssueYear})"}
  ]
}
