// src/prisma/schema.prisma

// Database configuration (PostgreSQL)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  email               String    @unique
  password            String
  role                String    @default("USER") // "ADMIN" or "USER"
  isApproved          Boolean   @default(false)
  autoApproveRequests Boolean   @default(false)
  canRequest          Boolean   @default(false)
  canDownload         Boolean   @default(false)
  canCreateGlobalLists  Boolean   @default(false)
  avatar              String?
  banner              String?
  createdAt           DateTime  @default(now())
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  
  // SECURITY FIX: Used to invalidate all active sessions instantly
  sessionVersion      Int       @default(0)

  requests            Request[]
  readProgresses      ReadProgress[]
  favorites           Favorite[]
  collections         Collection[]
  readingLists        ReadingList[]
  trophies            UserTrophy[]
  issueReports        IssueReport[]
  bookmarks           Bookmark[]
  reviews             Review[]
  dailyReadingStats   DailyReadingStat[]
  dailyIssueReads     DailyIssueRead[]
  auditLogs           AuditLog[]
  apiKeys             ApiKey[]  @relation("ApiKeysActsAs")
  createdApiKeys      ApiKey[]  @relation("ApiKeysCreatedBy")
  opdsKeys            OpdsKey[]
  koreaderSyncs       KoreaderSync[]
  readerPreferences   ReaderPreference[]
  libraryAccess       UserLibraryAccess[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  prefix      String
  
  userId      String
  user        User      @relation("ApiKeysActsAs", fields: [userId], references: [id], onDelete: Cascade)
  
  createdById String
  createdBy   User      @relation("ApiKeysCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([createdById])
}

model Request {
  id                 String   @id @default(cuid())
  userId             String   
  volumeId           String
  metadataSource     String   @default("COMICVINE")
  status             String   // PENDING_APPROVAL, PENDING, DOWNLOADING, MANUAL_DDL, IMPORTED
  progress           Int      @default(0)
  retryCount         Int      @default(0)
  indexer            String?
  downloadLink       String?
  activeDownloadName String?
  failedLinks        String? @default("[]")
  imageUrl           String?
  notified           Boolean  @default(false)  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([volumeId])
}

model Library {
  id        String   @id @default(cuid())
  name      String
  path      String   @unique
  isManga   Boolean  @default(false)
  isDefault Boolean  @default(false)
  defaultAccess Boolean @default(false) // Auto-granted to all users; new users are seeded with these libraries.

  series    Series[]
  userAccess UserLibraryAccess[]
}

// Per-user library grants. A non-admin user sees only libraries they have a row for (absence = no access).
// Admins bypass this entirely (see getAccessibleLibraryIds). New users are seeded with the default Comics
// library; pre-existing users were backfilled with all libraries (see db-init step 12).
model UserLibraryAccess {
  id        String  @id @default(cuid())
  userId    String
  libraryId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([userId, libraryId])
  @@index([userId])
  @@index([libraryId])
}

model Series {
  id              String   @id @default(cuid())
  cvId            Int?
  metronId        Int?
  metadataId      String?  
  metadataSource  String   @default("COMICVINE") 
  matchState      String?  @default("UNMATCHED")
  name            String
  year            Int
  publisher       String?
  folderPath      String
  universe        String?
  seriesGroup     String?  // ComicInfo <SeriesGroup>; umbrella folder for related series (providers don't supply it — set from ComicInfo.xml or manually)
  monitored       Boolean?
  isManga         Boolean  @default(false)
  size            Float?   @default(0)
  
  description     String?
  status          String?
  bookType        String?  // 'Print' | 'OneShot' | 'TPB' | 'GN' (Mylar booktype values); null = unknown
  coverUrl        String?
  remoteCoverUrl  String?  // Original ComicVine/Metron cover URL (coverUrl becomes a local path after caching)
  seriesJsonWritten Boolean @default(false) // Omnibus owns the series.json in this folder; foreign files are never overwritten
  hasCustomMetadata Boolean @default(false) // Series was manually curated in the metadata editor; auto-sync must not overwrite its narrative fields
  hasCustomCover  Boolean @default(false) // Admin uploaded a custom cover.jpg; extraction + provider-sync must never overwrite it
  lastMetadataSync DateTime? // Last successful provider sync (UTC); keys incremental fetches (Metron modified_gt)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  issues          Issue[]
  favorites       Favorite[]
  collectionItems CollectionItem[]
  issueReports    IssueReport[]
  reviews         Review[]
  readerPreferences ReaderPreference[]

  libraryId       String?
  library         Library? @relation(fields: [libraryId], references: [id], onDelete: SetNull)

  @@index([libraryId])
  @@index([metadataId]) // library pendingOnly branch filters metadataId IN (...); the composite unique can't serve a metadataId-only scan
  @@unique([metadataSource, metadataId])
}

model Issue {
  id              String   @id @default(cuid())
  seriesId        String
  series          Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  cvId            Int?
  metronId        Int?
  metadataId      String?  
  metadataSource  String   @default("COMICVINE")
  matchState      String?  @default("UNMATCHED")
  number          String
  status          String   @default("WANTED")
  filePath        String?
  pageCount       Int      @default(0)

  name            String?
  description     String?
  releaseDate     String?
  coverUrl        String?
  writers         String?
  artists         String?
  coverArtists    String?
  universe        String?
  colorists       String?
  letterers       String?
  characters      String?
  genres          String?
  storyArcs       String?
  teams           String?
  locations       String?
  hasCustomMetadata Boolean @default(false)
  hasCustomCover  Boolean @default(false) // Admin set a custom issue cover (in the Smart Matcher); sync must not overwrite coverUrl

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  readProgresses  ReadProgress[]
  readingListItems ReadingListItem[]
  bookmarks       Bookmark[]
  dailyIssueReads DailyIssueRead[]

  @@index([seriesId])
  @@index([metadataId])
  @@index([metadataSource])
  @@index([releaseDate]) // global calendar range-scans Issue.releaseDate (ISO YYYY-MM-DD, lexical = chronological)
  @@index([seriesId, releaseDate]) // library-wide issues view: per-series releaseDate scans when filtered by a Series field
}

model IssueReport {
  id            String   @id @default(cuid())
  seriesId      String
  userId        String
  description   String   
  status        String   @default("OPEN") 
  adminComment  String?
  notified      Boolean  @default(false) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  series        Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([seriesId])
  @@index([userId])
  @@index([status])
}

model DownloadClient {
  id         String  @id @default(cuid())
  name       String
  type       String  
  protocol   String  
  url        String
  user       String?
  pass       String?
  apiKey     String?
  category   String?
  remotePath String?
  localPath  String?
}

model DiscordWebhook {
  id       String  @id @default(cuid())
  name     String
  url      String
  isActive Boolean @default(true)
  events   String  
  botUsername  String?
  botAvatarUrl String?
}

model Indexer {
  id        Int     @id 
  name      String
  protocol  String
  priority  Int     @default(25)
  seedTime  Int     @default(0)
  seedRatio Float   @default(0)
  rss       Boolean @default(true)
}

model CustomHeader {
  id    String @id @default(cuid())
  key   String
  value String
}

model SearchAcronym {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model SystemSetting {
  key   String @id @unique
  value String
}

model ReadProgress {
  id          String   @id @default(cuid())
  userId      String
  issueId     String
  currentPage Int      @default(0)
  totalPages  Int      @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId]) 
  @@index([userId])
  @@index([issueId])
}

// Per-user, per-series reader settings (reading mode, scale, brightness, etc.) so a user's choices —
// especially manga RTL — survive page reloads and carry across issues of the same series.
model ReaderPreference {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  settings  Json
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
}

model Collection {
  id          String           @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      String           
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  seriesId     String
  order        Int      @default(0) 
  
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([collectionId, seriesId]) 
  @@index([collectionId])
  @@index([seriesId])
}

model JobLog {
  id          String   @id @default(cuid())
  jobType     String   
  status      String   
  relatedItem String?
  durationMs  Int?
  attempts    Int      @default(1)
  message     String?
  createdAt   DateTime @default(now())

  @@index([jobType])
  @@index([status])
}

model Trophy {
  id             String       @id @default(cuid())
  name           String       
  description    String       
  iconUrl        String?
  actionType     String       
  targetValue    Int          
  createdAt      DateTime     @default(now())

  earnedBy       UserTrophy[]
}

model UserTrophy {
  id          String   @id @default(cuid())
  userId      String
  trophyId    String
  notified    Boolean  @default(false) 
  earnedAt    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophy      Trophy   @relation(fields: [trophyId], references: [id], onDelete: Cascade)

  @@unique([userId, trophyId])
  @@index([userId])
  @@index([trophyId])
}

model ReadingList {
  id          String            @id @default(cuid())
  name        String
  description String?
  coverUrl    String?
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ReadingListItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  shareId     String?           @unique
  isGlobal    Boolean           @default(false)

  @@index([userId])
}

model ReadingListItem {
  id          String       @id @default(cuid())
  listId      String
  list        ReadingList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  
  issueId     String?
  issue       Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  
  cvIssueId   Int?
  metadataSource     String   @default("COMICVINE")
  title       String       
  order       Int          

  @@index([listId])
  @@index([issueId])
}

model OpdsKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  prefix     String
  
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  @@index([userId])
}

model KoreaderSync {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    String   
  progress    String   
  percentage  Float
  device      String
  deviceId    String
  timestamp   Int    

  @@unique([userId, document])
  @@index([userId])
}

model JobLock {
  id        String   @id
  lockedAt  DateTime @default(now())
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  issueId   String
  pageIndex Int
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId, pageIndex]) 
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  rating    Int      @default(0) 
  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId]) 
  @@index([seriesId])
}

model DailyReadingStat {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime 
  pagesRead Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model DailyIssueRead {
  id        String   @id @default(cuid())
  userId    String
  issueId   String
  date      DateTime
  pagesRead Int      @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId, date])
  @@index([userId, date])
  @@index([issueId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   
  details     String?
  ipAddress   String?
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
}

model HosterAccount {
  id        String   @id @default(cuid())
  name      String
  hoster    String   // e.g., 'mega', 'mediafire', 'pixeldrain'
  username  String?
  password  String?
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DigestHistory {
  id        String   @id @default(uuid())
  seriesId  String
  issueNum  String
  sentAt    DateTime @default(now())

  @@unique([seriesId, issueNum])
}